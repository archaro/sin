/* Canonical bytecode ABI opcode schema.
 * Fields:
 *   OP(enum_name, encoded_symbol, contexts, requires_runtime_handler,
 *      operand_kind, size_policy, validator, runtime_handler, stack_metadata,
 *      control_class)
 */
#define STACK_FIXED(P, Q) .stack_pops = P, .stack_pushes = Q, .stack_policy = IR_STACK_FIXED
#define STACK_DYNAMIC(P, Q, POLICY) .stack_pops = P, .stack_pushes = Q, .stack_policy = POLICY
OP(HALT, 'h', IR_OPCODE_CONTEXT_STATEMENT, false, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, 0, STACK_FIXED(0,0), IR_CONTROL_TERMINATING)
OP(RETURN, 'Q', IR_OPCODE_CONTEXT_STATEMENT, false, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, 0, STACK_FIXED(1,0), IR_CONTROL_TERMINATING)
OP(PUSH_INT, 'p', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_IMM_I64, SIZE_PUSH_INT, VALIDATE_NONE, op_pushint, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(PUSH_FLOAT, 'P', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_IMM_F64_BITS, SIZE_PUSH_FLOAT, VALIDATE_NONE, op_pushfloat, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(PUSH_BOOL, 'b', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_A_U8, SIZE_FIXED_2, VALIDATE_A_U8, op_pushbool, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(PUSH_STRING, 'l', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_IMM_CSTR, SIZE_PUSH_STRING, VALIDATE_NON_NULL_IMM, op_pushstr, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(PUSH_NIL, 'N', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_pushnil, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(ADD, 'a', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_add, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(SUB, 's', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_subtract, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(MUL, 'm', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_multiply, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(DIV, 'd', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_divide, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(MOD, '%', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_modulo, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(NEG, 'n', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_negate, STACK_FIXED(1,1), IR_CONTROL_STRAIGHT)
OP(EQ, 'o', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_equal, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(NEQ, 'q', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_notequal, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(LT, 'r', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_lessthan, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(GT, 't', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_greaterthan, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(LE, 'u', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_lessthanorequal, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(GE, 'v', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_greaterthanorequal, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(NOT, 'x', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_logicalnot, STACK_FIXED(1,1), IR_CONTROL_STRAIGHT)
OP(AND, 'y', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_logicaland, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(OR, 'z', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_logicalor, STACK_FIXED(2,1), IR_CONTROL_STRAIGHT)
OP(DISCARD, 'w', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_discard, STACK_FIXED(1,0), IR_CONTROL_STRAIGHT)
OP(LOAD_LOCAL, 'e', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_A_U8, SIZE_FIXED_2, VALIDATE_A_U8, op_getlocal, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(STORE_LOCAL, 'c', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_A_U8, SIZE_FIXED_2, VALIDATE_A_U8, op_savelocal, STACK_FIXED(1,0), IR_CONTROL_STRAIGHT)
OP(INC_LOCAL, 'f', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_A_U8, SIZE_FIXED_2, VALIDATE_A_U8, op_inclocal, STACK_FIXED(0,0), IR_CONTROL_STRAIGHT)
OP(DEC_LOCAL, 'g', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_A_U8, SIZE_FIXED_2, VALIDATE_A_U8, op_declocal, STACK_FIXED(0,0), IR_CONTROL_STRAIGHT)
OP(JUMP, 'j', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_LABEL_ID, SIZE_FIXED_3, VALIDATE_LABEL_ID, op_jump, STACK_FIXED(0,0), IR_CONTROL_JUMP)
OP(JUMP_IF_FALSE, 'k', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_LABEL_ID, SIZE_FIXED_3, VALIDATE_LABEL_ID, op_jumpfalse, STACK_FIXED(1,0), IR_CONTROL_CONDITIONAL)
OP(LABEL, 0, 0, false, OPERAND_LABEL_ID, SIZE_FIXED_0, VALIDATE_LABEL_ID, 0, STACK_FIXED(0,0), IR_CONTROL_IR_ONLY)
OP(ITEM_BEGIN, 'I', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_assembleitem, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(ITEM_BEGIN_REL, 'R', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_assembleitem_rel, STACK_FIXED(0,1), IR_CONTROL_STRAIGHT)
OP(ITEM_PUSH_LAYER, 'L', IR_OPCODE_CONTEXT_ITEM_EXPRESSION | IR_OPCODE_CONTEXT_DEREFERENCE, false, OPERAND_IMM_CSTR, SIZE_ITEM_PUSH_LAYER, VALIDATE_NON_NULL_IMM, 0, STACK_FIXED(0,0), IR_CONTROL_STRAIGHT)
OP(ITEM_PUSH_DEREF, 'D', IR_OPCODE_CONTEXT_ITEM_EXPRESSION | IR_OPCODE_CONTEXT_DEREFERENCE, false, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, 0, STACK_FIXED(0,0), IR_CONTROL_STRAIGHT)
OP(ITEM_PUSH_DEREF_LOCAL, 'V', IR_OPCODE_CONTEXT_ITEM_EXPRESSION | IR_OPCODE_CONTEXT_DEREFERENCE, false, OPERAND_A_U8, SIZE_FIXED_2, VALIDATE_A_U8, 0, STACK_FIXED(0,0), IR_CONTROL_STRAIGHT)
OP(ITEM_END, 'E', IR_OPCODE_CONTEXT_ITEM_EXPRESSION | IR_OPCODE_CONTEXT_DEREFERENCE, false, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, 0, STACK_FIXED(0,0), IR_CONTROL_STRAIGHT)
OP(ITEM_DEREF, 'F', IR_OPCODE_CONTEXT_DEREFERENCE, true, OPERAND_NONE, SIZE_FIXED_3, VALIDATE_NONE, op_fetchitem, STACK_FIXED(1,1), IR_CONTROL_STRAIGHT)
OP(ITEM_SAVE, 'C', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_assignitem, STACK_FIXED(2,0), IR_CONTROL_STRAIGHT)
OP(CALL, 'F', IR_OPCODE_CONTEXT_STATEMENT, false, OPERAND_A_U16, SIZE_FIXED_3, VALIDATE_A_U16, 0, STACK_DYNAMIC(1, 1, IR_STACK_CALL), IR_CONTROL_STRAIGHT)
OP(LIBCALL, 'M', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_LIBCALL_PAIR, SIZE_FIXED_3, VALIDATE_LIBCALL_PAIR, op_libcall, STACK_DYNAMIC(0, 1, IR_STACK_LIBCALL), IR_CONTROL_STRAIGHT)
OP(ITEM_SAVE_CODE, 'B', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_EMBEDDED_ID, SIZE_ITEM_SAVE_CODE, VALIDATE_EMBEDDED_INDEX, op_assigncodeitem, STACK_FIXED(1,0), IR_CONTROL_STRAIGHT)
OP(BUILD_LIST, '[', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_A_U32, SIZE_FIXED_5, VALIDATE_A_U32, op_build_list, STACK_DYNAMIC(0, 1, IR_STACK_BUILD_LIST), IR_CONTROL_STRAIGHT)
OP(MAKE_ITEMREF, '&', IR_OPCODE_CONTEXT_STATEMENT, true, OPERAND_NONE, SIZE_FIXED_1, VALIDATE_NONE, op_make_itemref, STACK_FIXED(1,1), IR_CONTROL_STRAIGHT)
#undef STACK_FIXED
#undef STACK_DYNAMIC
