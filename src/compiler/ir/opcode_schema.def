/* Canonical IR opcode schema.
 * Fields:
 *   OP(enum_name, encoded_symbol, operand_kind, size_policy, validator)
 */
OP(HALT,           'h', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(PUSH_INT,       'p', OPERAND_IMM_I64,    SIZE_PUSH_INT,       VALIDATE_NONE)
OP(PUSH_STRING,    'l', OPERAND_IMM_CSTR,   SIZE_PUSH_STRING,    VALIDATE_NON_NULL_IMM)
OP(ADD,            'a', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(SUB,            's', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(MUL,            'm', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(DIV,            'd', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(NEG,            'n', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(EQ,             'o', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(NEQ,            'q', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(LT,             'r', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(GT,             't', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(LE,             'u', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(GE,             'v', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(NOT,            'x', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(AND,            'y', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(OR,             'z', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(LOAD_LOCAL,     'e', OPERAND_A_U8,       SIZE_FIXED_2,        VALIDATE_A_U8)
OP(STORE_LOCAL,    'c', OPERAND_A_U8,       SIZE_FIXED_2,        VALIDATE_A_U8)
OP(INC_LOCAL,      'f', OPERAND_A_U8,       SIZE_FIXED_2,        VALIDATE_A_U8)
OP(DEC_LOCAL,      'g', OPERAND_A_U8,       SIZE_FIXED_2,        VALIDATE_A_U8)
OP(JUMP,           'j', OPERAND_LABEL_ID,   SIZE_FIXED_3,        VALIDATE_LABEL_ID)
OP(JUMP_IF_FALSE,  'k', OPERAND_LABEL_ID,   SIZE_FIXED_3,        VALIDATE_LABEL_ID)
OP(LABEL,          0,   OPERAND_LABEL_ID,   SIZE_FIXED_0,        VALIDATE_LABEL_ID)
OP(ITEM_BEGIN,     'I', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ITEM_BEGIN_REL, 'R', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ITEM_PUSH_LAYER,'L', OPERAND_IMM_CSTR,   SIZE_ITEM_PUSH_LAYER, VALIDATE_NON_NULL_IMM)
OP(ITEM_PUSH_DEREF,'D', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ITEM_END,       'E', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ITEM_DEREF,     'F', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ITEM_SAVE,      'C', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(CALL,           'F', OPERAND_A_U16,      SIZE_FIXED_3,        VALIDATE_A_U16)
OP(LIBCALL_TOKEN,  'M', OPERAND_A_U8,       SIZE_FIXED_2,        VALIDATE_A_U8)
OP(EXISTS,         'X', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(DELETE,         'W', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(NTHNAME,        'Y', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ROOTNAME,       'Z', OPERAND_NONE,       SIZE_FIXED_1,        VALIDATE_NONE)
OP(ITEM_SAVE_CODE, 'B', OPERAND_EMBEDDED_ID,SIZE_ITEM_SAVE_CODE, VALIDATE_EMBEDDED_INDEX)
