/* Canonical IR opcode schema.
 * Fields:
 *   OP(enum_name, encoded_symbol, requires_runtime_handler, operand_kind, size_policy, validator)
 */
OP(HALT,           'h', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(PUSH_INT,       'p', true,  OPERAND_IMM_I64,    SIZE_PUSH_INT,        VALIDATE_NONE)
OP(PUSH_FLOAT,     'P', true,  OPERAND_IMM_F64_BITS,SIZE_PUSH_FLOAT,      VALIDATE_NONE)
OP(PUSH_BOOL,      'b', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8)
OP(PUSH_STRING,    'l', true,  OPERAND_IMM_CSTR,   SIZE_PUSH_STRING,     VALIDATE_NON_NULL_IMM)
OP(ADD,            'a', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(SUB,            's', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(MUL,            'm', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(DIV,            'd', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(NEG,            'n', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(EQ,             'o', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(NEQ,            'q', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(LT,             'r', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(GT,             't', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(LE,             'u', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(GE,             'v', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(NOT,            'x', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(AND,            'y', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(OR,             'z', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(LOAD_LOCAL,     'e', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8)
OP(STORE_LOCAL,    'c', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8)
OP(INC_LOCAL,      'f', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8)
OP(DEC_LOCAL,      'g', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8)
OP(JUMP,           'j', true,  OPERAND_LABEL_ID,   SIZE_FIXED_3,         VALIDATE_LABEL_ID)
OP(JUMP_IF_FALSE,  'k', true,  OPERAND_LABEL_ID,   SIZE_FIXED_3,         VALIDATE_LABEL_ID)
OP(LABEL,          0,   false, OPERAND_LABEL_ID,   SIZE_FIXED_0,         VALIDATE_LABEL_ID)
OP(ITEM_BEGIN,     'I', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ITEM_BEGIN_REL, 'R', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ITEM_PUSH_LAYER,'L', false, OPERAND_IMM_CSTR,   SIZE_ITEM_PUSH_LAYER, VALIDATE_NON_NULL_IMM)
OP(ITEM_PUSH_DEREF,'D', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ITEM_END,       'E', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ITEM_DEREF,     'F', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ITEM_SAVE,      'C', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(CALL,           'F', false, OPERAND_A_U16,      SIZE_FIXED_3,         VALIDATE_A_U16)
OP(LIBCALL_TOKEN,  'M', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8)
OP(EXISTS,         'X', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(DELETE,         'W', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(NTHNAME,        'Y', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ROOTNAME,       'Z', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE)
OP(ITEM_SAVE_CODE, 'B', true,  OPERAND_EMBEDDED_ID,SIZE_ITEM_SAVE_CODE,  VALIDATE_EMBEDDED_INDEX)
