/* Canonical IR opcode schema.
 * Fields:
 *   OP(enum_name, encoded_symbol, requires_runtime_handler, operand_kind, size_policy, validator, runtime_handler)
 */
OP(HALT,           'h', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, 0)
OP(RETURN,         'Q', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, 0)
OP(PUSH_INT,       'p', true,  OPERAND_IMM_I64,    SIZE_PUSH_INT,        VALIDATE_NONE, op_pushint)
OP(PUSH_FLOAT,     'P', true,  OPERAND_IMM_F64_BITS,SIZE_PUSH_FLOAT,      VALIDATE_NONE, op_pushfloat)
OP(PUSH_BOOL,      'b', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8, op_pushbool)
OP(PUSH_STRING,    'l', true,  OPERAND_IMM_CSTR,   SIZE_PUSH_STRING,     VALIDATE_NON_NULL_IMM, op_pushstr)
OP(PUSH_NIL,       'N', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_pushnil)
OP(ADD,            'a', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_add)
OP(SUB,            's', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_subtract)
OP(MUL,            'm', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_multiply)
OP(DIV,            'd', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_divide)
OP(MOD,            '%', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_modulo)
OP(NEG,            'n', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_negate)
OP(EQ,             'o', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_equal)
OP(NEQ,            'q', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_notequal)
OP(LT,             'r', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_lessthan)
OP(GT,             't', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_greaterthan)
OP(LE,             'u', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_lessthanorequal)
OP(GE,             'v', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_greaterthanorequal)
OP(NOT,            'x', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_logicalnot)
OP(AND,            'y', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_logicaland)
OP(OR,             'z', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_logicalor)
OP(DISCARD,        'w', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_discard)
OP(LOAD_LOCAL,     'e', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8, op_getlocal)
OP(STORE_LOCAL,    'c', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8, op_savelocal)
OP(INC_LOCAL,      'f', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8, op_inclocal)
OP(DEC_LOCAL,      'g', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8, op_declocal)
OP(JUMP,           'j', true,  OPERAND_LABEL_ID,   SIZE_FIXED_3,         VALIDATE_LABEL_ID, op_jump)
OP(JUMP_IF_FALSE,  'k', true,  OPERAND_LABEL_ID,   SIZE_FIXED_3,         VALIDATE_LABEL_ID, op_jumpfalse)
OP(LABEL,          0,   false, OPERAND_LABEL_ID,   SIZE_FIXED_0,         VALIDATE_LABEL_ID, 0)
OP(ITEM_BEGIN,     'I', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_assembleitem)
OP(ITEM_BEGIN_REL, 'R', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_assembleitem_rel)
OP(ITEM_PUSH_LAYER,'L', false, OPERAND_IMM_CSTR,   SIZE_ITEM_PUSH_LAYER, VALIDATE_NON_NULL_IMM, 0)
OP(ITEM_PUSH_DEREF,'D', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, 0)
OP(ITEM_PUSH_DEREF_LOCAL,'V', false, OPERAND_A_U8, SIZE_FIXED_2,         VALIDATE_A_U8, 0)
OP(ITEM_END,       'E', false, OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, 0)
OP(ITEM_DEREF,     'F', true,  OPERAND_NONE,       SIZE_FIXED_3,         VALIDATE_NONE, op_fetchitem)
OP(ITEM_SAVE,      'C', true,  OPERAND_NONE,       SIZE_FIXED_1,         VALIDATE_NONE, op_assignitem)
OP(CALL,           'F', false, OPERAND_A_U16,      SIZE_FIXED_3,         VALIDATE_A_U16, 0)
OP(LIBCALL_TOKEN,  'M', true,  OPERAND_A_U8,       SIZE_FIXED_2,         VALIDATE_A_U8, op_libcall_token)
OP(ITEM_SAVE_CODE, 'B', true,  OPERAND_EMBEDDED_ID,SIZE_ITEM_SAVE_CODE,  VALIDATE_EMBEDDED_INDEX, op_assigncodeitem)
