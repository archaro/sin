target = code {@n} ( return @n + 1; );
once = code ( persist.count = persist.count + 1; return 7; );

if sys.fetch{sys.itemref{"persist.marker"}} == nil then
  persist.count = 0;
  persist.base = #[once, #[2, 3], &target, &missing.target];
  persist.empty = #[];
  persist.ref = &target;
  persist.dangling = &missing.target;
  persist.appended = list.append{persist.base, 4};
  persist.set = list.set{persist.appended, 1, #[8, 9]};
  persist.concat = list.concat{persist.base, #[5, 6]};
  persist.slice = list.slice{persist.concat, 1, 3};
  persist.marker = 1;
  sys.save;
  sys.log{"initialized"};
else
  sys.log{"reloaded"};
endif;

@ref = sys.itemref{"target"};
sys.log{persist.empty};
sys.log{persist.base};
sys.log{persist.appended};
sys.log{persist.set};
sys.log{persist.concat};
sys.log{persist.slice};
sys.log{persist.count};
sys.log{sys.fetch{persist.ref}};
sys.log{sys.call{persist.ref, #[41]}};
sys.log{sys.fetch{persist.dangling} == nil};
