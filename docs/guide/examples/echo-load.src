  /* The input item is called by a nominal 10ms timer; a busy event loop can
   * delay the callback. net.input processes at most one pending network event
   * each time it is called.
   */
  input = code (
  /* Is there anyone out there?
   * A return value of 0 means no network activity
   * A return value of 1 is a new connection
   * A return value of 2 is a disconnection, which isn't relevant here
   * A return value of 3 is a complete input line
   */
  @a = net.input;
  if @a == 1 then
    /* Send a cheery greeting to the new connection */
    net.write{input.line, "Hello!\n"};
  elsif @a == 3 then
    /* Data received.  Send it right back. */
    net.write{input.line, input.text};
    /* Newlines are stripped from input, so add one at the end */
    net.write{input.line, "\n"};
  endif;
  /* Return after this callback; the run-loop invokes the input item again. */
  );
