/* The input item is called by a nominal 10ms timer; a busy event loop can delay
 * the callback. net.input processes at most one pending network event each time
 * it is called.
 */
input = code (
@a = net.input;
if @a == 1 then
  /* Send a cheery greeting to the new connection */
  net.write{input.line, "Hello!  You are on line "};
  net.write{input.line, input.line};
  net.write{input.line, "\n"};
  /* input.line is the zero-based connection slot assigned by net.input. */
  /* Tell everyone else about the new connection. */
  @l = 0;
  /* This example broadcasts across lines 0 through 7; the runtime default is
   * 50 reusable zero-based connection slots. */
  while @l < 8 do
    if @l != input.line then
      net.write{@l, "Line "};
      net.write{@l, input.line};
      net.write{@l, " has connected.\n"};
    endif;
    @l++;
  endwhile;
elsif @a == 3 then
  if str.startswith{input.text, "\\"} then
    /* Process a command */
    @cmd = str.substr{input.text, 1, str.len{input.text}};
    docommand{input.line, @cmd};
  else
    /* Tell every other line what was said. */
    @l = 0;
    /* This example broadcasts across lines 0 through 7; the runtime default is
     * 50 reusable zero-based connection slots. */
    while @l < 8 do
      if @l != input.line then
        net.write{@l, "Line "};
        net.write{@l, input.line};
        net.write{@l, ": "};
        net.write{@l, input.text};
        net.write{@l, "\n"};
      endif;
      @l++;
    endwhile;
  endif;
elsif @a == 2 then
  /* net.input has reported the disconnect and made this slot reusable. */
  /* Tell every other line that there has been a disconnection. */
  @l = 0;
  /* This example broadcasts across lines 0 through 7; the runtime default is
   * 50 reusable zero-based connection slots. */
  while @l < 8 do
    if @l != input.line then
      net.write{@l, "Line "};
      net.write{@l, input.line};
      net.write{@l, " has disconnected.\n"};
    endif;
    @l++;
  endwhile;
endif;
/* Return after this callback; the run-loop invokes the input item again. */
);

/* A simple command processor */
docommand = code {@l, @cmd} (
  /* This is really naive. */
  if str.eqcasei{@cmd, "quit"} then
    net.write{@l, "You have been disconnected.\n"};
    net.ditch{@l};
  elsif str.eqcasei{@cmd, "shutdown"} then
    sys.shutdown;
  else
    net.write{@l, "Unrecognised command.\n"};
  endif;
);
